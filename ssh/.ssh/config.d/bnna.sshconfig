# BNNA container SSH access (consolidated from former bnna.d/* files)
# Pattern: public Host → internal Hostname via slc1.bnna.rynbrn.com + sclient proxy
# Tweak individual entries as needed (add Port, IdentityFile, User, etc.)

Host belowesucks.com
    Hostname %h.slc1.bnna.rynbrn.com
    ProxyCommand sclient --alpn ssh %n
    User app

Host cfi-notebook.com
    Hostname %h.slc1.bnna.rynbrn.com
    ProxyCommand sclient --alpn ssh %n
  User app

Host staging.app.cogburnbros.com
    Hostname %h.slc1.bnna.rynbrn.com
    ProxyCommand sclient --alpn ssh %n
    User app

Host persyburnette.com
    Hostname %h.slc1.bnna.rynbrn.com
    ProxyCommand sclient --alpn ssh %n

Host comments.persyburnette.com
    Hostname %h.slc1.bnna.rynbrn.com
    ProxyCommand sclient --alpn ssh %n

Host edvpbs.org
    Hostname %h.slc1.bnna.rynbrn.com
    ProxyCommand sclient --alpn ssh %n

Host ryanburnette.com
    Hostname %h.slc1.bnna.rynbrn.com
    ProxyCommand sclient --alpn ssh %n
