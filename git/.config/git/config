[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[pull]
	rebase = true
[init]
	defaultBranch = main
[user]
	name = Ryan Burnette
	email = ryan.burnette@gmail.com
	signingkey = ~/.ssh/id_ed25519
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[commit]
	gpgsign = false
[core]
	excludesfile = ~/.config/git/ignore
[gpg]
	format = ssh
[credential]
	helper = /Users/ryan/.local/bin/gh auth git-credential
