[include]
	path = config.local

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[pull]
	rebase = true
[init]
	defaultBranch = main
[user]
	name = Ryan Burnette
	email = ryan.burnette@gmail.com
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[core]
	excludesfile = ~/.config/git/ignore
[gpg]
	format = ssh
[gpg "ssh"]
	program = ssh-keygen
