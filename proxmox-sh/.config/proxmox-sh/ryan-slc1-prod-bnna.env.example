# shellcheck disable=SC2034

PROXMOX_BASE_URL='https://pvec-slc1.bnna.net/api2/json'
TLS_ROUTER_AUTH='PLACEHOLDER'

# Private Networking
# either use VNET
PROXMOX_VNET='rbvnet'
# or BRIDGE+VLAN
#PROXMOX_BRIDGE='vmbr0'
#PROXMOX_VLAN='1100'

# DNS Defaults
PROXMOX_NAMESERVER='1.1.1.3 9.9.9.9 198.60.22.2'
PROXMOX_SEARCH_SUFFIX='.localdomain'
PROXMOX_SEARCH_DOMAIN='localdomain'

# Instance Details
PROXMOX_TARGET_NODE='pve4'
PROXMOX_ID_PREFIX='1102'
# MUST be at least 2 (used as VMID and IP address)
PROXMOX_ID_START='21'
# MUST be at most 254 (default 249)
PROXMOX_ID_END='249'
PROXMOX_RESOURCE_POOL='ryan-resources'
PROXMOX_TEMPLATE_STORAGE='slc1-smb1-shared'
PROXMOX_TEMPLATE_DEFAULT='vztmpl/alpine-3.23-bnna_20260116_amd64.tar.zst'
PROXMOX_FS_POOL='slc1-tank1-ryan'
PROXMOX_DATA_POOL='slc1-tank1-ryan'

# URL, File or String
PROXMOX_AUTHORIZED_KEYS='https://ryanburnette.com/authorized_keys'
# or PROXMOX_AUTHORIZED_KEYS="$HOME/.ssh/authorized_keys"

# Direct IP domain (e.g. for tls-10-254-0-101.vms.example.com)
DIRECT_IP_DOMAIN='slc1.bnna.rynbrn.com'

# HA Requires Admin Permissions:
#    Path: /, Role: PVESysAdmin (Sys.Audit, Sys.Console)
#PROXMOX_HA_ENABLE=1

# Secrets
PROXMOX_TOKEN_ID='ryan@pve!TOKEN_NAME'
PROXMOX_TOKEN_SECRET='00000000-0000-4000-8000-000000000000'
